---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% if page.hero_image %}
  {% assign hero_image_url = page.hero_image %}
  {% unless hero_image_url contains '://' %}
    {% assign hero_image_url = hero_image_url | relative_url %}
  {% endunless %}
  <div
    class="page-hero-image-wrapper"
    style="width: 100vw; margin-left: calc(50% - 50vw); margin-top: -3rem; margin-bottom: 2rem; height: calc(100vh - 57px); height: calc(100dvh - 57px);"
  >
    <img
      class="page-hero-image"
      src="{{ hero_image_url }}"
      alt="{{ page.hero_image_alt | default: page.title }}"
      loading="eager"
      style="display: block; width: 100%; height: 100%; object-fit: cover;"
    >
    {% if page.hero_image_header %}
      <div class="page-hero-text">
        <h1 class="page-hero-title">{{ page.hero_image_header | escape }}</h1>
      </div>
    {% endif %}
  </div>
{% endif %}

<div class="post">
  <header class="post-header">
    {% unless page.hero_image_header %}
      <h1 class="post-title">{{ page.title }}</h1>
    {% endunless %}
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}
</div>
